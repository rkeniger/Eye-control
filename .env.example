RTSP_URL=rtsp://scrypted.local:43705/27de8bbd9f1f48a5
MODEL=yolo11s.pt
# Inference input size (longest side, px)
IMGSZ=1280
# Minimum detection confidence sent to the browser (slider can raise it further)
CONF=0.25
# Width of the JPEG preview sent to browsers
PREVIEW_WIDTH=1280
JPEG_QUALITY=75
# Cap on processed/streamed frames per second (each preview frame is ~300 KB at 1280px)
MAX_FPS=15
# ESP32 eyeball (mDNS name or http://<ip>); leave empty to disable eye control
EYE_URL=http://eyeball.local
EYE_SEND_HZ=15
# Taught gaze points (image position -> eye angles), written by the page's Calibrate panel
CALIBRATION_PATH=calibration.json
# Polygon outside which people are ignored, drawn on the page with Edit zone
ZONE_PATH=zone.json
HOST=0.0.0.0
PORT=8000
